{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nicos-food",
  "compatibility_date": "2026-10-30",
  "pages_build_output_dir": "./public",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nicos-food",
      "database_id": "67aa379f-38ad-4322-931d-a2de2838a454"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "nicos-food-images"
    }
  ]
}